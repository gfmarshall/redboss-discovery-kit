{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["profile_name", "jboss_version", "extract_groups"],
  "properties": {
    "profile_name": {"type": "string"},
    "jboss_version": {"type": "string"},
    "extract_groups": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["group", "xpath_files"],
        "properties": {
          "group": {"type": "string"},
          "xpath_files": {"type": "array", "items": {"type": "string"}}
        }
      }
    }
  }
}
